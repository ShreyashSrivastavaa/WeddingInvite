# ===================================================================
# RSVP Wedding Manager - Environment Configuration
# Copy this file to .env and configure the values appropriately.
# ===================================================================

# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Database Connections
# Development connection (local PostgreSQL or hosted like Neon)
DATABASE_URL="postgresql://postgres@localhost:5432/wedding_invite_dev"
# Dedicated test database (used by Vitest API tests)
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/wedding_invite_test"

# Security & Session Management (Min 32 characters)
SESSION_SECRET="change-this-to-a-very-secure-random-32-char-secret-key-12345"

# CORS & Proxy Settings
TRUST_PROXY=1
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Optional Integrations (Feature Flagged)
# Email Provider (If not set, password reset is hidden)
EMAIL_PROVIDER_API_KEY=""

# WhatsApp Cloud API (If not set, only Click-to-Chat is active)
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=""

# Storage Adapter (Optional for cover image upload; hidden if unconfigured)
STORAGE_ADAPTER=""
